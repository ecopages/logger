{
	"name": "@ecopages/logger",
	"version": "0.2.2",
	"license": "MIT",
	"main": "./dist/logger.js",
	"types": "./dist/logger.d.ts",
	"type": "module",
	"files": ["dist"],
	"repository": {
		"type": "git",
		"url": "https://github.com/ecopages/logger.git",
		"directory": "packages/logger"
	},
	"scripts": {
		"build": "bun run build.ts && bun run build:types",
		"build:types": "tsc -p tsconfig.build.json",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"lint-staged": "lint-staged",
		"prepare": "husky",
		"changeset": "changeset",
		"prerelease": "bun run build && bun test",
		"release": "changeset publish",
		"test:all": "bun test && bun test:browser",
		"test:browser": "bun test --preload happydom.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.5",
		"@happy-dom/global-registrator": "^17.1.0",
		"@types/bun": "latest",
		"husky": "^9.0.10",
		"lint-staged": "^15.2.2"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	}
}
